<Window x:Class="Clipper.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NullClipper"
        Icon="pack://application:,,,/Assets/clipper-icon.png"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FF111111"
        Opacity="1"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Cursor="Cross"
        Focusable="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F3F6FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hover"
                                Background="Transparent"
                                CornerRadius="10">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KindButton" TargetType="Button">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C4CDD8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="on"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarCloseButton" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hover"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#33EF4444"/>
                                <Setter Property="Foreground" Value="#FECACA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#55EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Image x:Name="FrozenImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderOptions.EdgeMode="Aliased"/>
        <Path x:Name="DimPath" Fill="#99000000"/>
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionBorder"
                       Stroke="White"
                       StrokeThickness="2"
                       Fill="Transparent"
                       Visibility="Collapsed"/>
            <Rectangle x:Name="WindowHighlight"
                       Stroke="#FF60A5FA"
                       StrokeThickness="2"
                       Fill="#22007AFF"
                       Visibility="Collapsed"/>
            <Polyline x:Name="FreeformLine"
                      Stroke="White"
                      StrokeThickness="2"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Visibility="Collapsed"/>
        </Canvas>
        <Border x:Name="SizeBadge"
                Background="{StaticResource OverlayChromeBrush}"
                BorderBrush="{StaticResource OverlayChromeBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,5"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeText"
                       Foreground="{StaticResource TextBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="Toolbar"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Background="{StaticResource OverlayChromeBrush}"
                BorderBrush="{StaticResource OverlayChromeBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="6,5"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.4" Direction="270" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Background="#12FFFFFF"
                        CornerRadius="10"
                        Padding="3"
                        Margin="2,0,4,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SnipKindButton"
                                Style="{StaticResource KindButton}"
                                Content="Snip"
                                ToolTip="Still image"
                                Click="OnSnipKind"/>
                        <Button x:Name="GifKindButton"
                                Style="{StaticResource KindButton}"
                                Content="GIF"
                                ToolTip="Record a short GIF of the region"
                                Click="OnGifKind"/>
                    </StackPanel>
                </Border>
                <Rectangle Width="1"
                           Fill="#22FFFFFF"
                           Margin="6,8"/>
                <Button x:Name="RectangleButton"
                        Style="{StaticResource ModeButton}"
                        Content="&#xE7A8;"
                        ToolTip="Rectangular snip"
                        Click="OnRectangleMode"/>
                <Button x:Name="FreeformButton"
                        Style="{StaticResource ModeButton}"
                        Content="&#xED5F;"
                        ToolTip="Freeform snip"
                        Click="OnFreeformMode"/>
                <Button x:Name="WindowButton"
                        Style="{StaticResource ModeButton}"
                        Content="&#xE78B;"
                        ToolTip="Window snip"
                        Click="OnWindowMode"/>
                <Button x:Name="FullScreenButton"
                        Style="{StaticResource ModeButton}"
                        Content="&#xE740;"
                        ToolTip="Fullscreen snip"
                        Click="OnFullScreen"/>
                <Rectangle Width="1"
                           Fill="#22FFFFFF"
                           Margin="6,8"/>
                <Button x:Name="CloseButton"
                        Style="{StaticResource ToolbarCloseButton}"
                        Content="&#xE711;"
                        ToolTip="Close"
                        Click="OnCloseClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
