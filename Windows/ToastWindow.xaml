<Window x:Class="Clipper.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NullClipper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        IsHitTestVisible="False">
    <Border Background="#F2111827"
            CornerRadius="14"
            Padding="14,12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <DockPanel>
            <Border x:Name="PreviewHost"
                    Width="56"
                    Height="40"
                    CornerRadius="6"
                    Background="#111827"
                    Margin="0,0,12,0"
                    ClipToBounds="True"
                    DockPanel.Dock="Left">
                <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Foreground="White"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailText"
                           Foreground="#9CA3AF"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
