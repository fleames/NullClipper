<Window x:Class="Clipper.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NullClipper"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/Assets/clipper-icon.png">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="NullClipper"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Snip a region, window, or screen. It copies to the clipboard."
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,4,0,18"/>

        <Button x:Name="CaptureButton"
                Content="Capture now"
                HorizontalAlignment="Stretch"
                Click="OnCaptureNow"/>

        <TextBlock Text="Hotkey"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,20,0,8"/>
        <Button x:Name="HotkeyButton"
                Background="#1F2937"
                HorizontalAlignment="Stretch"
                Click="OnHotkeyClick"/>
        <TextBlock x:Name="HotkeyHint"
                   Text="Click, then press the keys you want."
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="12"
                   Margin="0,8,0,0"/>

        <CheckBox x:Name="StartupBox"
                  Content="Start NullClipper with Windows"
                  Foreground="{StaticResource TextBrush}"
                  Margin="0,16,0,0"
                  Click="OnStartupToggled"/>

        <TextBlock Text="NullImage"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,20,0,8"/>
        <CheckBox x:Name="NullImageEnabledBox"
                  Content="Upload snips to NullImage and copy the link"
                  Foreground="{StaticResource TextBrush}"
                  Click="OnNullImageEnabledToggled"/>
        <ComboBox x:Name="NullImageExpiryBox"
                  Margin="0,12,0,0"
                  SelectionChanged="OnNullImageExpiryChanged">
            <ComboBoxItem Content="1 hour" Tag="1h"/>
            <ComboBoxItem Content="1 day" Tag="1d"/>
            <ComboBoxItem Content="3 days" Tag="3d"/>
            <ComboBoxItem Content="7 days" Tag="7d"/>
            <ComboBoxItem Content="Never" Tag="never"/>
        </ComboBox>
        <CheckBox x:Name="NullImageBurnBox"
                  Content="Burn after first view"
                  Foreground="{StaticResource TextBrush}"
                  Margin="0,12,0,0"
                  Click="OnNullImageBurnToggled"/>
        <PasswordBox x:Name="NullImagePasswordBox"
                     Background="{StaticResource CardBgBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderThickness="0"
                     Padding="8"
                     Margin="0,12,0,0"
                     PasswordChanged="OnNullImagePasswordChanged"/>
        <TextBlock Text="Password (optional) — protects each uploaded snip"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="12"
                   Margin="0,6,0,0"/>

        <Button x:Name="ExitButton"
                Content="Quit NullClipper"
                Background="#374151"
                Margin="0,22,0,0"
                Click="OnQuit"/>
    </StackPanel>
</Window>
