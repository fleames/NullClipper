<Window x:Class="Clipper.Windows.DelayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NullClipper"
        Icon="pack://application:,,,/Assets/clipper-icon.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="True"
        Cursor="Arrow"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Border Margin="12"
            Background="{StaticResource OverlayChromeBrush}"
            BorderBrush="{StaticResource OverlayChromeBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20,12,20,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Direction="270" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="CountText"
                       Text="3"
                       Foreground="{StaticResource TextBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="38"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MinWidth="40"/>
            <TextBlock x:Name="HintText"
                       Text="Esc cancels"
                       Foreground="{StaticResource QuietTextBrush}"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,1,0,0"/>
        </StackPanel>
    </Border>
</Window>
