<Application x:Class="Clipper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#111827"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF"/>
        <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI</FontFamily>
    </Application.Resources>
</Application>
